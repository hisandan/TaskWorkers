<mxfile host="drawio">
  <diagram id="insercion-agenda" name="Inserción en la agenda">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="920" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="c1" value="Insertar una tarea en una agenda ocupada (RN25)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="34" as="geometry" />
        </mxCell>

        <mxCell id="c2" value="Las tareas siguientes pueden correrse, pero ninguna puede perder su día de inicio: cada una debe trabajar ≥ 1 h ese día. Trabajador con 6 h/día; 15 px = 1 h." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#6b7280;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1300" height="24" as="geometry" />
        </mxCell>

        <mxCell id="c3" value="&lt;b&gt;Nueva tarea N&lt;/b&gt; con inicio D&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#4b5563&#x27;&gt;asignación manual, edición (RN22) o auto-asignación&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=40;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="70" y="110" width="320" height="50" as="geometry" />
        </mxCell>

        <mxCell id="c4" value="&lt;b&gt;1. Insertar N en la agenda&lt;/b&gt;&lt;br&gt;orden por día de inicio; si otra tarea inicia el mismo día, N va después de ella&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#4b5563&#x27;&gt;RN15 · solo se guarda el inicio (RN26)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="70" y="190" width="320" height="80" as="geometry" />
        </mxCell>

        <mxCell id="c5" value="&lt;b&gt;2. Recorrer TODA la agenda en orden&lt;/b&gt;&lt;br&gt;cada tarea arranca en su día de inicio o cuando termina la anterior (lo que pase después) y usa las horas que sobran del día&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#4b5563&#x27;&gt;rules.agenda() · RN14, RN15&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="70" y="300" width="320" height="95" as="geometry" />
        </mxCell>

        <mxCell id="c6" value="&lt;b&gt;3. ¿Cada tarea trabaja ≥ 1 h&lt;br&gt;en su día de inicio?&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#4b5563&#x27;&gt;rules.late_starts() == [] · RN25&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="70" y="425" width="320" height="140" as="geometry" />
        </mxCell>

        <mxCell id="c7" value="&lt;b&gt;Se acepta&lt;/b&gt;&lt;br&gt;se guarda el inicio de N; los fines de las siguientes se recalculan (RN26)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="c8" value="&lt;b&gt;Se rechaza&lt;/b&gt;&lt;br&gt;WorkerBusy (409); la agenda queda como estaba" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="240" y="600" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b5563;strokeWidth=1.5;fontSize=11;fontStyle=1;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

