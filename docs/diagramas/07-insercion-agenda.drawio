          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="c13" value="no: alguna la pierde" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b5563;strokeWidth=1.5;fontSize=11;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="c6" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="c14" value="&lt;b&gt;Caso 1 · la cascada cabe&lt;/b&gt;&lt;br&gt;Agenda: B 4 h (mar), C 6 h (mié)&lt;br&gt;Se inserta A 10 h (lun)&lt;br&gt;&lt;br&gt;&lt;b style=&#x27;color:#4d7a3a&#x27;&gt;✔ Se acepta&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#4b5563&#x27;&gt;B y C se corren, pero conservan su día de inicio (ESC-38, ESC-40)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="460" y="110" width="230" height="130" as="geometry" />
