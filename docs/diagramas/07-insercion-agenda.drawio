        <mxCell id="c57" value="libre · 5 h" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bdbdbd;dashed=1;fontSize=11;fontColor=#9ca3af;" vertex="1" parent="1">
