<mxfile host="drawio">
  <diagram id="capas-testing" name="Capas de testing">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="580" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Capas de testing — qué parte de la arquitectura ejercita cada una" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1f2937;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Cada barra cubre los componentes reales que corren en esa capa. Lo punteado se reemplaza por dobles." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6b7280;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1100" height="24" as="geometry" />
        </mxCell>

        <!-- encabezados de componentes -->
        <mxCell id="c0" value="&lt;b&gt;Navegador&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#4b5563'&gt;frontend Astro + React&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="100" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;adapters/http&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#4b5563'&gt;routers · schemas · errores&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="100" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;application/&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#4b5563'&gt;casos de uso&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="100" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;domain/rules.py&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#4b5563'&gt;funciones puras&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="100" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;adapters/sql · clock&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#4b5563'&gt;repositorios · reloj&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1020" y="100" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;Postgres&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#4b5563'&gt;Docker&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1210" y="96" width="180" height="58" as="geometry" />
        </mxCell>

        <!-- E2E -->
        <mxCell id="l_e2e" value="&lt;b&gt;E2E&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#4b5563'&gt;Playwright · 4 tests&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_e2e" value="Flujos de la demo en el navegador contra la app levantada (ESC-33 a ESC-36)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="260" y="180" width="1130" height="70" as="geometry" />
        </mxCell>

        <!-- Integration -->
        <mxCell id="l_int" value="&lt;b&gt;Integration&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#4b5563'&gt;pytest + TestClient · 28 casos&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_int" value="API real contra la base &lt;b&gt;taskworkers_test&lt;/b&gt;, con rollback por test: CRUD, validación del payload, código HTTP de cada error (ESC-37) y flujos de punta a punta. Solo el reloj se fija (&lt;i&gt;get_clock&lt;/i&gt;)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=12;strokeWidth=1.5;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="270" width="940" height="70" as="geometry" />
        </mxCell>

        <!-- Application -->
        <mxCell id="l_app" value="&lt;b&gt;Application&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#4b5563'&gt;pytest + dobles · 40 casos&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_app" value="Reglas que dependen del estado: tarea &lt;i&gt;done&lt;/i&gt;, ya asignada, fecha pasada, agenda ocupada, editar y borrar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=12;strokeWidth=1.5;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="360" width="370" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f_app" value="Dobles en memoria + &lt;i&gt;FixedClock&lt;/i&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;tests/fakes.py · sin Docker&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;fontSize=13;arcSize=12;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="1020" y="360" width="370" height="70" as="geometry" />
        </mxCell>

        <!-- Unit -->
        <mxCell id="l_unit" value="&lt;b&gt;Unit&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#4b5563'&gt;pytest · 34 casos&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_unit" value="Skills, fechas, agenda y &lt;i&gt;auto_assign&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="830" y="450" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- eje -->
        <mxCell id="axis" value="" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#9ca3af;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1430" y="510" as="sourcePoint" />
            <mxPoint x="1430" y="190" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="axis_top" value="más real&lt;br&gt;más lento" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6b7280;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1442" y="180" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="axis_bottom" value="más rápido&lt;br&gt;más casos borde" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6b7280;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1442" y="480" width="120" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
