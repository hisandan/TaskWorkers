<mxfile host="drawio">
  <diagram id="auto-asignacion" name="Auto-asignación">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="1190" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Flujo de auto-asignación (Req4)" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1f2937;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="AssignmentService.auto_assign() prepara y guarda · rules.auto_assign() decide el reparto sin tocar la base" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6b7280;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1100" height="24" as="geometry" />
        </mxCell>

        <!-- contenedores (al fondo) -->
        <mxCell id="c_app" value="application · AssignmentService.auto_assign() — lee por los puertos" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=#f3f9f1;strokeColor=#82b366;verticalAlign=top;align=right;spacingRight=14;spacingTop=8;fontStyle=1;fontSize=12;fontColor=#4d7a3a;" vertex="1" parent="1">
          <mxGeometry x="120" y="180" width="760" height="265" as="geometry" />
        </mxCell>
        <mxCell id="c_dom" value="domain · rules.auto_assign() — puro, sin base de datos" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffcf0;strokeColor=#d6b656;verticalAlign=top;align=right;spacingRight=14;spacingTop=8;fontStyle=1;fontSize=12;fontColor=#9a7b1c;" vertex="1" parent="1">
          <mxGeometry x="120" y="465" width="760" height="680" as="geometry" />
        </mxCell>

        <!-- pasos -->
        <mxCell id="start" value="&lt;b&gt;POST /api/v1/assignments/auto&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="200" y="100" width="260" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="Pendientes = tareas &lt;b&gt;not-done&lt;/b&gt; sin asignación&lt;br&gt;&lt;span style='font-size:10px;color:#4b5563'&gt;RN17 · no reasigna las existentes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="165" y="215" width="330" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="inicio = siguiente día hábil después de hoy&lt;br&gt;&lt;span style='font-size:10px;color:#4b5563'&gt;mañana, o el lunes si mañana es fin de semana · Clock · RN20&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="165" y="291" width="330" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="agendas = rules.agenda de cada trabajador&lt;br&gt;&lt;span style='font-size:10px;color:#4b5563'&gt;worker_id → Schedule de su última tarea · RN26&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="165" y="367" width="330" height="56" as="geometry" />
        </mxCell>

        <mxCell id="d_loop" value="¿Quedan tareas&lt;br&gt;pendientes?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="200" y="495" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p_cand" value="Candidatos = trabajadores con skills ⊇ skills(tarea)&lt;br&gt;&lt;span style='font-size:10px;color:#4b5563'&gt;can_take · RN18&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="150" y="635" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d_has" value="¿Hay&lt;br&gt;candidatos?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="200" y="735" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p_pick" value="Para cada candidato: schedule(..., after=agenda)&lt;br&gt;elegir el que &lt;b&gt;termina más pronto&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#4b5563'&gt;RN19 · va al final de su agenda · orden RN27 · desempate RN28&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="150" y="875" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p_add" value="Agregar a &lt;b&gt;assigned&lt;/b&gt;&lt;br&gt;actualizar la agenda del elegido" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="165" y="985" width="330" height="56" as="geometry" />
        </mxCell>
        <mxCell id="next" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4b5563;strokeColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="320" y="1085" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="unassigned" value="Agregar a &lt;b&gt;unassigned&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#4b5563'&gt;se reporta en la respuesta · RN21&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="580" y="755" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="save" value="assignments.save() por cada asignada&lt;br&gt;&lt;span style='font-size:10px;color:#4b5563'&gt;solo start_date · una transacción: todo o nada&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="940" y="515" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="end" value="&lt;b&gt;200 OK&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;{ assigned, unassigned }&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="940" y="625" width="250" height="60" as="geometry" />
        </mxCell>

        <!-- flechas -->
        <mxCell id="f0" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4b5563;" edge="1" parent="1" source="start" target="p1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f1" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4b5563;" edge="1" parent="1" source="p1" target="p2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4b5563;" edge="1" parent="1" source="p2" target="p3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4b5563;" edge="1" parent="1" source="p3" target="d_loop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="sí" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4b5563;fontSize=11;labelBackgroundColor=#fffcf0;" edge="1" parent="1" source="d_loop" target="p_cand">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="no" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4b5563;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d_loop" target="save">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f6" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4b5563;" edge="1" parent="1" source="save" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f7" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4b5563;" edge="1" parent="1" source="p_cand" target="d_has">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f8" value="sí" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4b5563;fontSize=11;labelBackgroundColor=#fffcf0;" edge="1" parent="1" source="d_has" target="p_pick">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f9" value="no" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=11;fontColor=#b85450;labelBackgroundColor=#fffcf0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d_has" target="unassigned">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f10" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4b5563;" edge="1" parent="1" source="p_pick" target="p_add">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f11" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#4b5563;" edge="1" parent="1" source="p_add" target="next">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeWidth=1.5;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="unassigned" target="next">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f13" value="siguiente tarea" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4b5563;fontSize=11;labelBackgroundColor=#fffcf0;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="next" target="d_loop">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
