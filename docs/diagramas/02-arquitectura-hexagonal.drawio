        <mxCell id="hex_dom" value="&lt;b&gt;domain/&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;models.py: Task · Worker · Assignment&lt;br&gt;rules.py: Slot · Schedule · can_take · schedule · agenda · late_starts · auto_assign&lt;br&gt;errors.py: NotFound · Conflict · InvalidInput&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=45;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
