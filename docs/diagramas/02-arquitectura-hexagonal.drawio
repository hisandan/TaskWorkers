<mxfile host="drawio">
  <diagram id="arquitectura-hexagonal" name="Arquitectura hexagonal">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="640" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Arquitectura hexagonal — puertos y adaptadores" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1f2937;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Regla de dependencias: adapters → application → domain. El núcleo no importa FastAPI ni SQLAlchemy." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6b7280;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1000" height="24" as="geometry" />
        </mxCell>

        <!-- entrada -->
        <mxCell id="fe" value="&lt;b&gt;Frontend&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Astro + React · openapi-fetch&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="210" height="64" as="geometry" />
        </mxCell>
        <mxCell id="http" value="&lt;b&gt;adapters/http&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#4b5563'&gt;adaptador de entrada&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;routers FastAPI&lt;br&gt;schemas Pydantic (TaskIn / TaskOut…)&lt;br&gt;errors.py → 404 · 409 · 422&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="210" height="150" as="geometry" />
        </mxCell>
        <mxCell id="comp" value="&lt;b&gt;http/dependencies.py&lt;/b&gt;&lt;br&gt;Punto de composición: arma cada servicio con Sql*Repository + SystemClock" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="210" height="80" as="geometry" />
        </mxCell>

        <!-- núcleo -->
        <mxCell id="hex_app" value="&lt;b&gt;application/&lt;/b&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=90;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;spacingTop=14;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="105" width="480" height="420" as="geometry" />
        </mxCell>
        <mxCell id="services" value="TaskService · WorkerService · AssignmentService&lt;br&gt;&lt;span style='font-size:11px;color:#4b5563'&gt;leen por puertos · validan estado · llaman a rules · guardan&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
