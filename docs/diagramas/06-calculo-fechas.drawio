<mxfile host="drawio">
  <diagram id="calculo-fechas" name="Cálculo de fechas">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="720" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Cálculo de fechas — trabajador con 6 h/día" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1f2937;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Se guarda solo el inicio de A (viernes) y de B (lunes); los fines se calculan recorriendo la agenda (RN26)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6b7280;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="900" height="24" as="geometry" />
        </mxCell>

        <!-- eje -->
        <mxCell id="axis" value="&lt;b&gt;horas del día&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;disponibilidad&lt;br&gt;6 h / día hábil&lt;/span&gt;" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#4b5563;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="150" width="130" height="180" as="geometry" />
        </mxCell>

        <!-- encabezados de día -->
        <mxCell id="d_vie" value="Viernes" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="160" y="110" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="d_sab" value="Sábado" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#9ca3af;" vertex="1" parent="1">
          <mxGeometry x="320" y="110" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="d_dom" value="Domingo" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#9ca3af;" vertex="1" parent="1">
          <mxGeometry x="480" y="110" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="d_lun" value="Lunes" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="640" y="110" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="d_mar" value="Martes" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="800" y="110" width="150" height="30" as="geometry" />
        </mxCell>

        <!-- bloques de horas (30 px = 1 h) -->
        <mxCell id="vie_a" value="&lt;b&gt;A&lt;/b&gt; · 6 h" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="160" y="150" width="150" height="180" as="geometry" />
        </mxCell>
        <mxCell id="sab" value="no hábil&lt;br&gt;&lt;span style='font-size:10px'&gt;RN12&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bdbdbd;dashed=1;fontSize=12;fontColor=#9ca3af;" vertex="1" parent="1">
          <mxGeometry x="320" y="150" width="150" height="180" as="geometry" />
        </mxCell>
        <mxCell id="dom" value="no hábil&lt;br&gt;&lt;span style='font-size:10px'&gt;RN12&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bdbdbd;dashed=1;fontSize=12;fontColor=#9ca3af;" vertex="1" parent="1">
          <mxGeometry x="480" y="150" width="150" height="180" as="geometry" />
        </mxCell>
        <mxCell id="lun_a" value="&lt;b&gt;A&lt;/b&gt; · 4 h" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="640" y="150" width="150" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lun_b" value="&lt;b&gt;B&lt;/b&gt; · 2 h" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="640" y="270" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mar_b" value="&lt;b&gt;B&lt;/b&gt; · 3 h" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="800" y="150" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="mar_free" value="libre · 3 h" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bdbdbd;dashed=1;fontSize=12;fontColor=#9ca3af;" vertex="1" parent="1">
          <mxGeometry x="800" y="240" width="150" height="90" as="geometry" />
        </mxCell>

        <!-- resultado tipo Gantt -->
        <mxCell id="bar_a" value="&lt;b&gt;A&lt;/b&gt; (10 h): start = viernes → end = lunes (calculado)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#6c8ebf;fontColor=#ffffff;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="160" y="365" width="630" height="30" as="geometry" />
        </mxCell>
        <mxCell id="bar_b" value="&lt;b&gt;B&lt;/b&gt; (5 h): lunes → martes (calculado)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#82b366;fontColor=#ffffff;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="405" width="310" height="30" as="geometry" />
        </mxCell>
        <mxCell id="bars_label" value="resultado" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#4b5563;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="385" width="130" height="30" as="geometry" />
        </mxCell>

        <!-- notas -->
        <mxCell id="rules" value="&lt;b&gt;Reglas que aplican rules.schedule() y rules.agenda()&lt;/b&gt;&lt;br&gt;&lt;br&gt;• RN12: solo se trabaja de lunes a viernes.&lt;br&gt;• RN13: si el inicio cae en fin de semana, pasa al lunes.&lt;br&gt;• RN14: cada día consume hasta la disponibilidad; lo que no cabe sigue el siguiente día hábil.&lt;br&gt;• RN15: B arranca cuando termina A, con las horas que sobran (6 − 4 = 2 h el lunes).&lt;br&gt;• RN16: el fin es el último día hábil con horas de la tarea.&lt;br&gt;• RN25: B conserva su día de inicio porque trabaja ≥ 1 h el lunes. Si A creciera a 12 h, B quedaría sin horas el lunes y se rechaza (WorkerBusy)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffdf5;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="560" height="220" as="geometry" />
        </mxCell>
        <mxCell id="sig" value="&lt;b&gt;Firmas&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;schedule(effort, availability,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;start, after)&lt;br&gt;→ Schedule(start, end,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;last_day_hours)&lt;br&gt;&lt;br&gt;agenda(slots, availability)&lt;br&gt;→ {task_id: Schedule}&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#4b5563'&gt;Slot = (task_id, effort, start). after = la tarea anterior en la agenda. Schedule no se guarda.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#9ca3af;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="470" width="310" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
