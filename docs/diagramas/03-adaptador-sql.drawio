        <mxCell id="s1" value="Request HTTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="70" y="636" width="150" height="56" as="geometry" />
