        <!-- flechas: entidad <-> repo <-> fila -> tabla -->
        <mxCell id="e1a" value="recibe / devuelve" style="html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4b5563;fontSize=10;fontColor=#4b5563;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ent_task" target="repo_task">
