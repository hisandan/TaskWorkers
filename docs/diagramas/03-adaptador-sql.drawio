        <mxCell id="s2" value="get_session()&lt;br&gt;&lt;span style='font-size:11px'&gt;session.begin()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="280" y="636" width="170" height="56" as="geometry" />
