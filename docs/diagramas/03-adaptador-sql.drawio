        <!-- notas de implementación -->
        <mxCell id="notes" value="&lt;b&gt;Notas de implementación&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;save()&lt;/b&gt;: sin id → add + flush (obtiene el id); con id → actualiza la fila existente.&lt;br&gt;&lt;br&gt;• &lt;b&gt;get()&lt;/b&gt;: devuelve None si no existe; el servicio lanza TaskNotFound / WorkerNotFound.&lt;br&gt;&lt;br&gt;• &lt;b&gt;delete()&lt;/b&gt;: el servicio valida antes HasAssignments (RN24).&lt;br&gt;&lt;br&gt;• &lt;b&gt;skills&lt;/b&gt;: el dominio usa nombres (list[str]); al guardar, db.skill_rows() busca o crea cada SkillRow.&lt;br&gt;&lt;br&gt;• &lt;b&gt;list_by_worker()&lt;/b&gt;: ordenado por id; con rules.agenda se calculan las fechas de fin (RN15, RN26).&lt;br&gt;&lt;br&gt;• Nunca devolver una *Row: siempre la dataclass del dominio.&lt;br&gt;&lt;br&gt;• Se prueba en tests/integration (requiere make db)." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fffdf5;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1230" y="140" width="300" height="400" as="geometry" />
        </mxCell>

        <!-- transacción por request -->
        <mxCell id="tx" value="Una transacción por request · db.get_session()" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#9ca3af;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="1490" height="150" as="geometry" />
