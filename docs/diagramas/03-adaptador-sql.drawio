        <mxCell id="s7" value="La auto-asignación guarda todo o nada." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#4b5563;fontStyle=2;" vertex="1" parent="1">
