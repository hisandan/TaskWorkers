        <mxCell id="n6" value="no" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d6" target="x6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="no" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d7" target="x7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- notas -->
        <mxCell id="note_http" value="&lt;b&gt;Error de dominio → HTTP&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#4b5563'&gt;adapters/http/errors.py&lt;/span&gt;&lt;br&gt;&lt;br&gt;NotFound → 404&lt;br&gt;Conflict → 409 &lt;span style='font-size:11px;color:#4b5563'&gt;(choca con el estado)&lt;/span&gt;&lt;br&gt;InvalidInput → 422 &lt;span style='font-size:11px;color:#4b5563'&gt;(dato inválido)&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff5f5;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="200" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="note_layers" value="&lt;b&gt;¿Quién hace qué?&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#6c8ebf'&gt;■&lt;/font&gt; application: valida contra el estado leyendo por los puertos&lt;br&gt;&lt;font color='#d6b656'&gt;■&lt;/font&gt; domain/rules.py: skills y fechas (funciones puras)&lt;br&gt;&lt;font color='#82b366'&gt;■&lt;/font&gt; puertos: lectura y guardado" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#9ca3af;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="370" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="note_edit" value="&lt;b&gt;Editar tarea o trabajador (RN22)&lt;/b&gt;&lt;br&gt;&lt;br&gt;PUT /tasks/{id} o /workers/{id} con asignaciones repite el chequeo con el cambio aplicado:&lt;br&gt;• rules.can_take en cada tarea del trabajador → MissingSkills (409)&lt;br&gt;• rules.late_starts con el esfuerzo o la disponibilidad nuevos → WorkerBusy (409)&lt;br&gt;&lt;br&gt;Si falla, no se guarda nada." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="540" width="300" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
