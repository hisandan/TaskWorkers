<mxfile host="drawio">
  <diagram id="capa-aplicacion" name="Capa de aplicación">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="940" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Capa de aplicación — app/application/" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1f2937;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Los casos de uso orquestan: no calculan fechas ni deciden repartos, eso lo hace domain/rules.py. Solo conocen los puertos, no Postgres." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6b7280;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1300" height="24" as="geometry" />
        </mxCell>

        <!-- patrón -->
        <mxCell id="p1" value="&lt;b&gt;1. Leer&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;por los puertos&lt;/span&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;2. Validar contra el estado&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;existe · done · ya asignada · fecha · RN8, RN9, RN11, RN13, RN24&lt;/span&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="340" y="100" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;3. Delegar el cálculo&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;skills, agenda y reparto en rules.py&lt;/span&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="720" y="100" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;4. Guardar&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;por los puertos · 1 transacción por request&lt;/span&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1040" y="100" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- entrada -->
        <mxCell id="http" value="&lt;b&gt;adapters/http&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#4b5563'&gt;los routers llaman a un servicio; dependencies.py lo arma con sus adaptadores&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="180" height="120" as="geometry" />
        </mxCell>

        <!-- contenedor application -->
        <mxCell id="app_box" value="&lt;b&gt;application/&lt;/b&gt; · casos de uso" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="260" y="200" width="760" height="580" as="geometry" />
        </mxCell>

        <mxCell id="svc_task" value="&lt;b&gt;TaskService&lt;/b&gt; · tasks.py · &lt;font color='#6b7280'&gt;Req1&lt;/font&gt;&lt;hr&gt;&lt;b&gt;all · get&lt;/b&gt;&lt;br&gt;&lt;b&gt;create&lt;/b&gt; — nace not-done · &lt;font color='#6b7280'&gt;RN2&lt;/font&gt;&lt;br&gt;&lt;b&gt;update&lt;/b&gt; — si está asignada revalida skills y agenda · &lt;font color='#6b7280'&gt;RN22, RN6, RN25&lt;/font&gt;&lt;br&gt;&lt;b&gt;delete&lt;/b&gt; — no si tiene asignación · &lt;font color='#6b7280'&gt;RN24&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="280" y="250" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="svc_worker" value="&lt;b&gt;WorkerService&lt;/b&gt; · workers.py · &lt;font color='#6b7280'&gt;Req2&lt;/font&gt;&lt;hr&gt;&lt;b&gt;all · get · create&lt;/b&gt;&lt;br&gt;&lt;b&gt;update&lt;/b&gt; — sus tareas siguen cumpliendo las skills y la agenda aguanta la nueva disponibilidad · &lt;font color='#6b7280'&gt;RN22, RN6, RN25&lt;/font&gt;&lt;br&gt;&lt;b&gt;delete&lt;/b&gt; — no si tiene asignaciones · &lt;font color='#6b7280'&gt;RN24&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="280" y="430" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="svc_assign" value="&lt;b&gt;AssignmentService&lt;/b&gt; · assignments.py · &lt;font color='#6b7280'&gt;Req3, Req3a, Req4&lt;/font&gt;&lt;hr&gt;&lt;b&gt;all&lt;/b&gt; — asignaciones con su fin calculado · &lt;font color='#6b7280'&gt;RN26&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;assign&lt;/b&gt;(task, worker, start)&lt;br&gt;&amp;nbsp;&amp;nbsp;existe · fecha válida · not-done · sin asignar&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font color='#6b7280'&gt;RN11, RN13, RN8, RN9&lt;/font&gt; → &lt;i&gt;_place&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;move&lt;/b&gt;(assignment, worker, start)&lt;br&gt;&amp;nbsp;&amp;nbsp;eliminar + asignar en un paso; conserva su id · &lt;font color='#6b7280'&gt;RN31&lt;/font&gt; → &lt;i&gt;_place&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;delete&lt;/b&gt;(assignment)&lt;br&gt;&amp;nbsp;&amp;nbsp;quitar horas no rompe la agenda · &lt;font color='#6b7280'&gt;RN30&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;auto_assign&lt;/b&gt;()&lt;br&gt;&amp;nbsp;&amp;nbsp;pendientes not-done sin asignar · &lt;font color='#6b7280'&gt;RN17&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;desde el siguiente día hábil · &lt;font color='#6b7280'&gt;RN20&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;el reparto lo decide &lt;b&gt;rules.auto_assign&lt;/b&gt;&lt;hr&gt;&lt;i&gt;_place&lt;/i&gt; — skills + inserción en la agenda · &lt;font color='#6b7280'&gt;RN6, RN25&lt;/font&gt;&lt;br&gt;&lt;i&gt;_check_start&lt;/i&gt; — no pasado, no fin de semana · &lt;font color='#6b7280'&gt;RN11, RN13&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="640" y="250" width="360" height="350" as="geometry" />
        </mxCell>

        <mxCell id="helpers" value="&lt;b&gt;Funciones compartidas&lt;/b&gt; · assignments.py&lt;hr&gt;&lt;b&gt;worker_slots&lt;/b&gt; — la agenda guardada como Slots, incluidas las done · &lt;font color='#6b7280'&gt;RN23&lt;/font&gt;&lt;br&gt;&lt;b&gt;check_start_days&lt;/b&gt; — compara late_starts antes y después del cambio → WorkerBusy · &lt;font color='#6b7280'&gt;RN25&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="280" y="640" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="readm" value="&lt;b&gt;Read models&lt;/b&gt; · lo que devuelve&lt;hr&gt;&lt;b&gt;ScheduledAssignment&lt;/b&gt; — asignación + end_date calculado&lt;br&gt;&lt;b&gt;AutoAssignReport&lt;/b&gt; — assigned + unassigned · &lt;font color='#6b7280'&gt;RN21&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="640" width="360" height="110" as="geometry" />
        </mxCell>

        <!-- puertos -->
        <mxCell id="ports_box" value="&lt;b&gt;ports.py&lt;/b&gt; · Protocol" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#d6b656;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="1060" y="200" width="280" height="580" as="geometry" />
        </mxCell>
        <mxCell id="port_t" value="&lt;b&gt;TaskRepository&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;all · get · save · delete&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="250" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="port_w" value="&lt;b&gt;WorkerRepository&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;all · get · save · delete&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="330" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="port_a" value="&lt;b&gt;AssignmentRepository&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;all · get · save · delete&lt;br&gt;get_by_task · list_by_worker&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="410" width="240" height="74" as="geometry" />
        </mxCell>
        <mxCell id="port_c" value="&lt;b&gt;Clock&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;today() · &quot;hoy&quot; es un puerto · RN11, RN20&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="504" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ports_note" value="&lt;b&gt;Los implementan:&lt;/b&gt;&lt;br&gt;• adapters/sql + clock.py (la app)&lt;br&gt;• tests/fakes.py: en memoria y FixedClock (los tests de application)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#9ca3af;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=12;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="1080" y="600" width="240" height="110" as="geometry" />
        </mxCell>

        <!-- dominio -->
        <mxCell id="domain" value="&lt;b&gt;domain/&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;rules: can_take · business_day · agenda · late_starts · auto_assign&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;errors: MissingSkills, TaskDone, WorkerBusy…&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;models: Task, Worker, Assignment&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;arcSize=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="260" y="820" width="1080" height="80" as="geometry" />
        </mxCell>

        <!-- flechas -->
        <mxCell id="x_http" value="llama" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b7280;fontSize=11;fontColor=#6b7280;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.172;entryDx=0;entryDy=0;" edge="1" parent="1" source="http" target="app_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="x_ports" value="usa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b7280;fontSize=11;fontColor=#6b7280;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="app_box" target="ports_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="x_dom" value="delega el cálculo y lanza sus errores" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b7280;fontSize=11;fontColor=#6b7280;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="app_box" target="domain">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82b366;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc_task" target="helpers">
          <mxGeometry relative="1" as="geometry">
