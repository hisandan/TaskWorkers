        <mxCell id="i2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="svc_worker" target="helpers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82b366;exitX=0;exitY=0.92;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc_assign" target="helpers">
