        <mxCell id="n_skills" value="&lt;b&gt;Skills en tabla propia (RN3)&lt;/b&gt;&lt;br&gt;Etiquetas sin nivel: skills.name UNIQUE, relacionadas N:M con tareas y trabajadores.&lt;br&gt;RN6: skills(tarea) ⊆ skills(trabajador). Con un join se ve quién puede tomar cada tarea." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n_unique" value="&lt;b&gt;Una tarea, una asignación (RN9)&lt;/b&gt;&lt;br&gt;task_id UNIQUE → máximo una fila por tarea.&lt;br&gt;RN24: no se borra una tarea o un trabajador con asignaciones (HasAssignments → 409; la FK lo respalda)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="425" y="470" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n_agenda" value="&lt;b&gt;Solo se guarda el inicio (RN25, RN26)&lt;/b&gt;&lt;br&gt;start_date = día de inicio comprometido: la tarea trabaja al menos 1 h ese día.&lt;br&gt;Las fechas de fin no se guardan: rules.agenda las calcula recorriendo las asignaciones del trabajador por (start_date, id)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="810" y="470" width="340" height="120" as="geometry" />
        </mxCell>
