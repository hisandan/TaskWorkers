        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b7280;" edge="1" parent="1" source="f_late" target="f_agenda">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b7280;" edge="1" parent="1" source="f_agenda" target="f_schedule">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6b7280;" edge="1" parent="1" source="f_schedule" target="f_bday">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================= errors.py ================= -->
        <mxCell id="err_box" value="&lt;b&gt;errors.py&lt;/b&gt; · errores de negocio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="1240" y="100" width="440" height="790" as="geometry" />
        </mxCell>
        <mxCell id="err_root" value="&lt;b&gt;DomainError&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1260" y="150" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="err_nf" value="&lt;b&gt;NotFound&lt;/b&gt; &lt;font color='#6b7280'&gt;→ 404&lt;/font&gt;&lt;hr&gt;TaskNotFound&lt;br&gt;WorkerNotFound&lt;br&gt;AssignmentNotFound" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1310" y="230" width="350" height="110" as="geometry" />
        </mxCell>
        <mxCell id="err_cf" value="&lt;b&gt;Conflict&lt;/b&gt; &lt;font color='#6b7280'&gt;→ 409 · choca con el estado actual&lt;/font&gt;&lt;hr&gt;MissingSkills · &lt;font color='#6b7280'&gt;RN6&lt;/font&gt;&lt;br&gt;TaskDone · &lt;font color='#6b7280'&gt;RN8&lt;/font&gt;&lt;br&gt;TaskAlreadyAssigned · &lt;font color='#6b7280'&gt;RN9&lt;/font&gt;&lt;br&gt;WorkerBusy · &lt;font color='#6b7280'&gt;RN25&lt;/font&gt;&lt;br&gt;HasAssignments · &lt;font color='#6b7280'&gt;RN24&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1310" y="370" width="350" height="160" as="geometry" />
        </mxCell>
        <mxCell id="err_ii" value="&lt;b&gt;InvalidInput&lt;/b&gt; &lt;font color='#6b7280'&gt;→ 422 · inválido por sí solo&lt;/font&gt;&lt;hr&gt;StartInPast · &lt;font color='#6b7280'&gt;RN11&lt;/font&gt;&lt;br&gt;StartNotBusinessDay · &lt;font color='#6b7280'&gt;RN13&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1310" y="560" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="err_note" value="El dominio no conoce HTTP: los códigos los asigna &lt;b&gt;adapters/http/errors.py&lt;/b&gt; según el grupo. Los lanzan los casos de uso de la capa de aplicación." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#9ca3af;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=12;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="1260" y="700" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="h1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;strokeColor=#6b7280;startArrow=none;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="err_nf" target="err_root">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="h2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;strokeColor=#6b7280;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="err_cf" target="err_root">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="h3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;strokeColor=#6b7280;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="err_ii" target="err_root">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
